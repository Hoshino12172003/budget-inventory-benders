{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E2 fixed-policy common-scenario recourse result",
  "type": "object",
  "required": [
    "scenario_id",
    "shock_set",
    "policy_id",
    "policy_hash",
    "instance_hash",
    "solver_status",
    "total_shipment",
    "total_shortage",
    "shortage_by_product",
    "service_violation_by_product",
    "total_service_violation",
    "transportation_cost",
    "shortage_penalty_cost",
    "service_penalty_cost",
    "recourse_cost",
    "economic_optimum_recourse_cost",
    "reporting_tie_break_cost_delta"
  ],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^S[0-9]{4}$"},
    "shock_set": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "array",
        "prefixItems": [{"type": "string"}, {"type": "string"}],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "policy_id": {"type": "string"},
    "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "instance_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "solver_status": {"const": "OPTIMAL"},
    "total_shipment": {"type": "number", "minimum": 0},
    "total_shortage": {"type": "number", "minimum": 0},
    "shortage_by_product": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "service_violation_by_product": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "total_service_violation": {"type": "number", "minimum": 0},
    "transportation_cost": {"type": "number", "minimum": 0},
    "shortage_penalty_cost": {"type": "number", "minimum": 0},
    "service_penalty_cost": {"type": "number", "minimum": 0},
    "recourse_cost": {"type": "number", "minimum": 0},
    "economic_optimum_recourse_cost": {"type": "number", "minimum": 0},
    "reporting_tie_break_cost_delta": {"type": "number"}
  },
  "additionalProperties": false
}
