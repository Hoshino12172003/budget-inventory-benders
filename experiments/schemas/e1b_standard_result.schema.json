{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E1b Standard Benders formal result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "run_id", "dataset_id", "case", "method", "status",
    "exact_certification_status", "Gamma", "beta", "B", "lambda_R",
    "objective", "first_stage_expenditure", "robust_recourse_cost",
    "core_runtime_seconds", "post_evaluation_runtime_seconds",
    "master_runtime_seconds", "oracle_runtime_seconds",
    "cut_construction_runtime_seconds", "certification_runtime_seconds",
    "iteration_count", "aggregate_cut_count", "lower_bound", "upper_bound",
    "absolute_gap", "relative_gap", "instance_hash", "x0_hash",
    "calibration_hash", "mapping_hash", "solver_profile", "solver_version"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "dataset_id": {"const": "RENAULT_EMPIRICAL_8CASE_V1"},
    "case": {"type": "string"},
    "method": {"const": "standard_benders"},
    "status": {"type": "string"},
    "exact_certification_status": {"type": "string"},
    "Gamma": {"const": 2},
    "beta": {"const": 1.0},
    "B": {"type": "number"},
    "lambda_R": {"const": 0.05},
    "objective": {"type": "number"},
    "first_stage_expenditure": {"type": "number"},
    "robust_recourse_cost": {"type": "number"},
    "core_runtime_seconds": {"type": "number"},
    "post_evaluation_runtime_seconds": {"type": "number"},
    "master_runtime_seconds": {"type": "number"},
    "oracle_runtime_seconds": {"type": "number"},
    "cut_construction_runtime_seconds": {"type": "number"},
    "certification_runtime_seconds": {"type": "number"},
    "iteration_count": {"type": "integer"},
    "aggregate_cut_count": {"type": "integer"},
    "lower_bound": {"type": "number"},
    "upper_bound": {"type": "number"},
    "absolute_gap": {"type": "number"},
    "relative_gap": {"type": "number"},
    "instance_hash": {"type": "string"},
    "x0_hash": {"type": "string"},
    "calibration_hash": {"type": "string"},
    "mapping_hash": {"type": "string"},
    "solver_profile": {"type": "string"},
    "solver_version": {"type": "string"}
  }
}
