{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E2 stockout formal common-scenario task checkpoint",
  "type": "object",
  "required": [
    "schema_version",
    "classification",
    "experiment_id",
    "task_id",
    "case_id",
    "policy_id",
    "authorization_manifest_sha256",
    "identity_manifest_sha256",
    "scenario_manifest_sha256",
    "runner_sha256",
    "evaluator_sha256",
    "protocol_sha256",
    "scenario_result_schema_sha256",
    "formal_checkpoint_schema_sha256",
    "instance_sha256",
    "policy_sha256",
    "scenario_order_sha256",
    "scenario_id_order_sha256",
    "solver_profile_id",
    "solver_version",
    "threads",
    "runtime_seconds",
    "scenario_count",
    "evaluation",
    "metric_summary"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "classification": {"const": "FORMAL_COMMON_SCENARIO_RESULT"},
    "experiment_id": {"const": "E2_STOCKOUT_COMMON_SCENARIO_V1"},
    "task_id": {"type": "string", "pattern": "^E2S-[0-9]{6}-(EXISTING|ROBUST)$"},
    "case_id": {"type": "string", "pattern": "^[0-9]{6}$"},
    "policy_id": {"type": "string", "pattern": "^(EXISTING_CANONICAL|ROBUST_EQUIVALENT_SCAL_BASE)_[0-9]{6}$"},
    "authorization_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenario_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runner_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenario_result_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "formal_checkpoint_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "instance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenario_order_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenario_id_order_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "solver_profile_id": {"const": "gurobi-balanced-1e-8-v1"},
    "solver_version": {"type": "string", "minLength": 1},
    "threads": {"const": 1},
    "runtime_seconds": {"type": "number", "minimum": 0},
    "scenario_count": {"const": 4657},
    "evaluation": {"type": "object"},
    "metric_summary": {
      "type": "object",
      "required": [
        "coverage_status",
        "scenario_count",
        "scenario_id_set_sha256",
        "scenario_id_order_sha256",
        "nominal_common_scenario",
        "worst_over_frozen_set"
      ],
      "properties": {
        "coverage_status": {"const": "COMPLETE_FROZEN_SCENARIO_SET"},
        "scenario_count": {"const": 4657}
      }
    }
  },
  "additionalProperties": false
}
