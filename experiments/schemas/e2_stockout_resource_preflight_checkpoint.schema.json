{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E2 stockout non-publishable full-case resource preflight checkpoint",
  "type": "object",
  "required": [
    "schema_version",
    "classification",
    "experiment_id",
    "task_id",
    "case_id",
    "policy_id",
    "formal_run_authorized",
    "preflight_authorization_sha256",
    "identity_manifest_sha256",
    "scenario_manifest_sha256",
    "runner_sha256",
    "evaluator_sha256",
    "protocol_sha256",
    "scientific_confirmation_sha256",
    "checkpoint_schema_sha256",
    "instance_sha256",
    "policy_sha256",
    "scenario_order_sha256",
    "scenario_id_order_sha256",
    "block_order_sha256",
    "solver_profile_id",
    "solver_version",
    "threads",
    "scenario_count",
    "total_blocks",
    "completed_blocks",
    "completion_status",
    "protocol_interrupt_exercised",
    "policy_coordinates_before_sha256",
    "block_results",
    "run_segments"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "classification": {"const": "PREFLIGHT_NON_PUBLISHABLE"},
    "experiment_id": {"const": "E2_STOCKOUT_COMMON_SCENARIO_V1"},
    "task_id": {"const": "PREFLIGHT-210202-EXISTING"},
    "case_id": {"const": "210202"},
    "policy_id": {"const": "EXISTING_CANONICAL_210202"},
    "formal_run_authorized": {"const": false},
    "preflight_authorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenario_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runner_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scientific_confirmation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpoint_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "instance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenario_order_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenario_id_order_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "block_order_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "solver_profile_id": {"const": "gurobi-balanced-1e-8-v1"},
    "solver_version": {"type": "string", "minLength": 1},
    "threads": {"const": 1},
    "scenario_count": {"const": 4657},
    "total_blocks": {"const": 632},
    "completed_blocks": {"type": "integer", "minimum": 1, "maximum": 632},
    "completion_status": {
      "enum": ["INCOMPLETE_CHECKPOINT", "INTERRUPTED_BY_PROTOCOL", "COMPLETE"]
    },
    "protocol_interrupt_exercised": {"type": "boolean"},
    "policy_coordinates_before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_coordinates_after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "block_results": {"type": "array", "minItems": 1, "maxItems": 632},
    "run_segments": {"type": "array", "minItems": 1},
    "resume_validation": {"type": "object"},
    "runtime_seconds": {"type": "number", "minimum": 0},
    "peak_process_rss_bytes": {"type": "integer", "minimum": 0},
    "economic_optimal_block_count": {"type": "integer", "minimum": 0, "maximum": 632},
    "reporting_optimal_block_count": {"type": "integer", "minimum": 0, "maximum": 632},
    "evaluation": {"type": "object"},
    "metric_summary": {"type": "object"}
  },
  "additionalProperties": false
}
