{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E6 5x5 budget-risk interaction result",
  "type": "object",
  "required": [
    "run_id", "experiment_id", "case", "beta_token", "beta", "Gamma_token", "Gamma",
    "lambda_R", "B", "B_ref", "dataset_id", "instance_hash", "x0_hash",
    "calibration_hash", "mapping_hash", "model_identity_sha256", "solver_profile",
    "reused", "reuse_source_experiment", "reuse_source_run", "objective", "fixed_cost",
    "inventory_cost", "reconfiguration_cost", "robust_recourse_cost", "budget_used",
    "budget_utilization", "RI", "active_depots", "active_depot_ids", "status",
    "certification_status", "exact_certification_pass"
  ],
  "properties": {
    "run_id": {"type": "string", "pattern": "^E6-5X5-[0-9]{6}-B(080|090|100|110|120)-G[0-4]$"},
    "experiment_id": {"const": "E6_BUDGET_RISK_5X5_V1"},
    "beta_token": {"enum": ["B080", "B090", "B100", "B110", "B120"]},
    "beta": {"enum": [0.8, 0.9, 1.0, 1.1, 1.2]},
    "Gamma_token": {"enum": ["G0", "G1", "G2", "G3", "G4"]},
    "Gamma": {"enum": [0, 1, 2, 3, 4]},
    "lambda_R": {"const": 0.05},
    "reused": {"type": "boolean"},
    "reuse_source_experiment": {"type": ["string", "null"]},
    "reuse_source_run": {"type": ["string", "null"]},
    "status": {"const": "OPTIMAL"},
    "certification_status": {"const": "CERTIFIED_PRB_EXACT"},
    "exact_certification_pass": {"const": true}
  },
  "additionalProperties": true
}
